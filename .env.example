# 先运行 python setup.py 可自动生成配置，通常无需手动编辑此文件
# 个人微信推送需要 Server酱 Turbo（SCT 开头的 SendKey）
NOTIFIER=serverchan
SERVERCHAN_SENDKEY=SCT_替换为真实SendKey

# 邮箱授权码（不是网页登录密码）；分开获取、不要在聊天中分享
QQ_MAIL_AUTH_CODE=在此输入QQ邮箱IMAP授权码
NETEASE_MAIL_AUTH_CODE=在此输入163邮箱IMAP授权码

# 学校邮箱客户端专用密码（官网：设置→安全设置→客户端安全登录）
# 学校自 2024-06-30 起要求客户端使用专用密码，非 NetID/网页登录密码
XJTU_MAIL_APP_PASSWORD=在此输入学校邮箱客户端专用密码

# 自动扫描时间以你希望的时区为准
TIMEZONE=Asia/Shanghai
POLL_SECONDS=300
DIGEST_TIME=19:00
FIRST_RUN_HOURS=24
MAX_SCAN_PER_ACCOUNT=150
# 每封邮件最多拉取 256 KiB，避免下载巨型附件
MAX_MAIL_BYTES=262144
# 验证失败后至少 10 分钟再试，默认 1 小时，避免安全锁定
AUTH_RETRY_SECONDS=3600
# 每天最多推 5 条，预留 1 条日报
DAILY_PUSH_LIMIT=5
DB_PATH=data/mail_assistant.sqlite3

# 可选：本机 AI；不开启则用纯离线规则
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=qwen2.5:7b
# AI_API_KEY=
